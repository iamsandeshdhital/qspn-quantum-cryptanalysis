{
 "cells": [
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# Advanced Error Mitigation Techniques\n",
    "\n",
    "This notebook demonstrates state-of-the-art error mitigation techniques:\n",
    "\n",
    "1. **Readout-error mitigation** (assignment-matrix inversion)\n",
    "2. **Zero-noise extrapolation** (ZNE)\n",
    "3. **Clifford data regression** (CDR)\n",
    "4. **Unified mitigation pipeline**\n",
    "\n",
    "These techniques are essential for quantum computing labs, companies, and universities working with NISQ devices."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import sys\n",
    "sys.path.insert(0, '../src')\n",
    "\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "from qspn.mitigation import (\n",
    "    MitigationPipeline,\n",
    "    zne_extrapolate,\n",
    "    cdr_mitigate,\n",
    "    calibration_circuits,\n",
    "    AssignmentMatrix,\n",
    "    counts_to_vector,\n",
    "    mitigate_vector,\n",
    "    negative_mass,\n",
    ")\n",
    "from qspn.noise import NoiseParams, build_noise_model\n",
    "from qspn.runner import RunConfig, run_counts, transpile_for\n",
    "from qspn.grover import grover_circuit, optimal_iterations\n",
    "from qspn.spn import SPNParams, make_attack_instance\n",
    "\n",
    "print('All imports successful!')"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 1. Setup: Build a Grover Circuit with Noise"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Build the attack instance\n",
    "params = SPNParams(key_bits=4, rounds=2)\n",
    "pairs = make_attack_instance(0b1101, params)\n",
    "iterations = optimal_iterations(params.key_space, 1)\n",
    "\n",
    "# Create the Grover circuit\n",
    "circuit = grover_circuit(pairs, iterations, params, measure=True)\n",
    "print(f'Circuit: {circuit.num_qubits} qubits, {len(circuit.operations)} operations')\n",
    "print(f'Optimal iterations: {iterations}')"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 2. Readout-Error Mitigation\n",
    "\n",
    "Characterize the readout error using calibration circuits, then invert the assignment matrix."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Run calibration circuits\n",
    "config = RunConfig(shots=4096)\n",
    "noise_params = NoiseParams(p1=1e-3, p2=1e-2, p_read_1_given_0=0.02, p_read_0_given_1=0.04)\n",
    "\n",
    "cal_circuits = calibration_circuits(params.key_bits)\n",
    "cal_counts = []\n",
    "for c in cal_circuits:\n",
    "    transpiled = transpile_for(c, config)\n",
    "    counts = run_counts(transpiled, noise_params, config, already_transpiled=True)\n",
    "    cal_counts.append(counts)\n",
    "\n",
    "# Build assignment matrix\n",
    "assignment = AssignmentMatrix.from_calibration_counts(cal_counts, params.key_bits, config.shots)\n",
    "print(f'Mean readout fidelity: {assignment.mean_readout_fidelity:.4f}')\n",
    "print(f'Condition number: {assignment.condition_number:.2f}')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Run the Grover circuit with noise\n",
    "transpiled = transpile_for(circuit, config)\n",
    "noisy_counts = run_counts(transpiled, noise_params, config, already_transpiled=True)\n",
    "noisy_vec = counts_to_vector(noisy_counts, params.key_bits)\n",
    "\n",
    "# Apply different mitigation methods\n",
    "methods = ['pinv', 'clip', 'nnls']\n",
    "results = {}\n",
    "for method in methods:\n",
    "    mitigated = mitigate_vector(assignment.matrix, noisy_vec, method)\n",
    "    results[method] = mitigated\n",
    "    p_success = mitigated[0b1101]\n",
    "    neg_mass = negative_mass(mitigated)\n",
    "    print(f'{method:5s}: P(key) = {p_success:.4f}, negative mass = {neg_mass:.4f}')"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 3. Zero-Noise Extrapolation (ZNE)\n",
    "\n",
    "Run the circuit at multiple noise levels and extrapolate to zero noise."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Run at different noise scale factors\n",
    "scale_factors = [1.0, 2.0, 3.0]\n",
    "noisy_values = []\n",
    "\n",
    "for sf in scale_factors:\n",
    "    scaled_noise = noise_params.scaled(sf)\n",
    "    counts = run_counts(transpiled, scaled_noise, config, already_transpiled=True)\n",
    "    vec = counts_to_vector(counts, params.key_bits)\n",
    "    p_success = vec[0b1101]\n",
    "    noisy_values.append(p_success)\n",
    "    print(f'Scale {sf:.1f}: P(key) = {p_success:.4f}')\n",
    "\n",
    "# Extrapolate to zero noise\n",
    "zne_result = zne_extrapolate(scale_factors, noisy_values, method='richardson')\n",
    "print(f'\\nZNE zero-noise estimate: {zne_result[\"zero_noise_estimate\"]:.4f}')"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 4. Unified Mitigation Pipeline\n",
    "\n",
    "Chain multiple mitigation techniques for maximum error suppression."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Create a mitigation pipeline\n",
    "pipeline = MitigationPipeline()\n",
    "pipeline.add_readout_mitigation(assignment.matrix)\n",
    "pipeline.add_zne(scale_factors, noisy_values)\n",
    "\n",
    "# Apply the pipeline\n",
    "pipeline_results = pipeline.apply(noisy_counts, num_qubits=params.key_bits)\n",
    "\n",
    "print('Pipeline results:')\n",
    "for key, value in pipeline_results.items():\n",
    "    if isinstance(value, np.ndarray):\n",
    "        print(f'  {key}: P(key) = {value[0b1101]:.4f}')\n",
    "    else:\n",
    "        print(f'  {key}: {value}')"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 5. Visualization"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Plot the distributions\n",
    "fig, axes = plt.subplots(1, 3, figsize=(15, 4))\n",
    "\n",
    "# Raw noisy\n",
    "axes[0].bar(range(16), noisy_vec)\n",
    "axes[0].set_title('Raw (Noisy)')\n",
    "axes[0].set_xlabel('Key')\n",
    "axes[0].set_ylabel('Probability')\n",
    "\n",
    "# After readout mitigation\n",
    "axes[1].bar(range(16), results['nnls'])\n",
    "axes[1].set_title('After Readout Mitigation (NNLS)')\n",
    "axes[1].set_xlabel('Key')\n",
    "\n",
    "# After full pipeline\n",
    "axes[2].bar(range(16), pipeline_results['final'])\n",
    "axes[2].set_title('After Full Pipeline')\n",
    "axes[2].set_xlabel('Key')\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Summary\n",
    "\n",
    "| Method | P(key) | Improvement |\n",
    "|--------|--------|-------------|\n",
    "| Raw (noisy) | {:.4f} | - |\n",
    "| Readout mitigation (NNLS) | {:.4f} | {:.1f}% |\n",
    "| ZNE | {:.4f} | {:.1f}% |\n",
    "| Full pipeline | {:.4f} | {:.1f}% |\n",
    "\n",
    "These techniques are essential for extracting useful results from NISQ devices and are widely used in quantum computing labs and companies.".format(\n",
    "    noisy_vec[0b1101],\n",
    "    results['nnls'][0b1101],\n",
    "    100 * (results['nnls'][0b1101] - noisy_vec[0b1101]) / noisy_vec[0b1101],\n",
    "    zne_result['zero_noise_estimate'],\n",
    "    100 * (zne_result['zero_noise_estimate'] - noisy_vec[0b1101]) / noisy_vec[0b1101],\n",
    "    pipeline_results['final'][0b1101],\n",
    "    100 * (pipeline_results['final'][0b1101] - noisy_vec[0b1101]) / noisy_vec[0b1101],\n",
    ")"
   ]
  }
 ],
